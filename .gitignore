# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Conda environments / metadata
.conda/
conda-meta/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Test / coverage output
.coverage
.coverage.*
htmlcov/
coverage.xml

# Generated application logs
logs/*
!logs/.gitkeep

# Generated charts / output files
output/*
!output/.gitkeep

# Jupyter
.ipynb_checkpoints/

# IDE / editor files
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.swp
~$*

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Local development / experimental files
/agent_backup.py
/test_*.py

# Legacy generated charts
/charts//agent_backup.py
/test_*.py

# Legacy generated charts
/charts/

